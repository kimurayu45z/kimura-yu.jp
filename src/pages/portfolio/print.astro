---
import PortfolioDocument from '@/components/PortfolioDocument.astro';
import { getPortfolio } from '@/content/portfolio';
import { getLocale } from '@/paraglide/runtime';
import { site } from '@/site';
import '@/styles/global.css';
import '@fontsource/noto-sans-jp/400.css';
import '@fontsource/noto-sans-jp/600.css';
import '@fontsource/noto-sans-jp/700.css';

const locale = getLocale();
const content = getPortfolio(locale);
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<link rel="canonical" href={`${site.url}/${locale}`} />
		<title>{content.title} | KIMURA Yu</title>
	</head>
	<body>
		<main><PortfolioDocument {locale} presentation="print" /></main>
	</body>
</html>

<style is:global>
	@page {
		size: A4 portrait;
		margin: 16mm 17mm 18mm;
		@bottom-left {
			content: 'KIMURA Yu | www.kimura-yu.jp';
			font-family: sans-serif;
			font-size: 7pt;
			color: #65718a;
		}
		@bottom-right {
			content: counter(page);
			font-family: sans-serif;
			font-size: 7pt;
			color: #65718a;
		}
	}
	@media print {
		html,
		body {
			background: white !important;
			background-image: none !important;
		}
		* {
			print-color-adjust: exact;
			-webkit-print-color-adjust: exact;
		}
	}
</style>
