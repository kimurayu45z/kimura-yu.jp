---
import { ArrowUpRight, GraduationCap, ShieldCheck } from '@lucide/astro';

import BusinessCardCarousel from '@/components/BusinessCardCarousel.svelte';
import ShareActions from '@/components/ShareActions.svelte';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { publicContacts } from '@/lib/server/contacts';
import * as m from '@/paraglide/messages';
import { getLocale, type Locale } from '@/paraglide/runtime';
import { site } from '@/site';

const locale: Locale = getLocale();
const contacts = publicContacts();
const publicUrl = `${site.entryUrl}/${locale}`;

const education = [
	{ date: m.education_2015_date(), body: m.education_2015_body() },
	{ date: m.education_2019_03_date(), body: m.education_2019_03_body() },
	{ date: m.education_2019_04_date(), body: m.education_2019_04_body() },
	{ date: m.education_2021_date(), body: m.education_2021_body() },
	{
		date: m.education_2022_03_date(),
		body: m.education_2022_03_body(),
		note: m.education_2022_03_note()
	},
	{ date: m.education_2022_04_date(), body: m.education_2022_04_body() }
];

const credentials = [
	{ date: m.credential_2021_06_date(), body: m.credential_2021_06_body() },
	{ date: m.credential_2021_10_date(), body: m.credential_2021_10_body() },
	{ date: m.credential_2022_10_date(), body: m.credential_2022_10_body() }
];

const businessCards = [
	{
		id: 'cauchye',
		label: m.organization_cauchye(),
		organizations: [m.organization_cauchye()],
		website: contacts.cauchyeUrl ? { label: 'cauchye.com', href: contacts.cauchyeUrl } : undefined
	},
	{
		id: 'rising-fuku',
		label: `${m.organization_rising_sun()} / FUKU`,
		organizations: [
			m.organization_rising_sun(),
			m.organization_fuku_fund(),
			m.organization_fuku_materials()
		],
		website: contacts.teppanUrl
			? { label: 'teppan.ownerbook.io', href: contacts.teppanUrl }
			: undefined
	}
];

const shareLabels = {
	add: m.action_add_contact(),
	share: m.action_share(),
	copy: m.action_copy_link(),
	copied: m.action_copied()
};

const socialLogos: Readonly<Record<string, string>> = {
	X: '/assets/logos/x.svg',
	Facebook: '/assets/logos/facebook.svg',
	LinkedIn: '/assets/logos/linkedin.svg'
};
---

<BaseLayout {locale}>
	<section class="card-page">
		<BusinessCardCarousel
			name={m.hero_name()}
			latinName={m.hero_name_latin()}
			cards={businessCards}
			qrSrc={`/${locale}/qr.svg`}
			qrAlt={m.contact_qr_alt()}
			previousLabel={m.carousel_previous()}
			nextLabel={m.carousel_next()}
			client:load
		/>

		<div class="mt-7">
			<ShareActions
				url={publicUrl}
				vcardUrl={`/${locale}/contact.vcf`}
				title={m.meta_title()}
				labels={shareLabels}
				client:load
			/>
		</div>

		<section class="app-panel mt-5" aria-labelledby="social-heading">
			<h2 id="social-heading">{m.contact_social()}</h2>
			<div class="social-grid">
				{
					contacts.socials.map((entry) => (
						<a href={entry.href} target="_blank" rel="noreferrer">
							<img src={socialLogos[entry.label]} alt="" width="18" height="18" />
							<span>{entry.label}</span>
						</a>
					))
				}
				<a class="note-social" href={site.noteUrl} target="_blank" rel="noreferrer">
					<img src="/assets/logos/note.svg" alt="" width="18" height="18" />
					<span>
						<small>note</small>
						<strong>{m.story_title()}</strong>
					</span>
					<ArrowUpRight />
				</a>
			</div>
		</section>

		<section id="education" class="record-panel mt-4" aria-labelledby="education-heading">
			<header>
				<span class="row-icon"><GraduationCap /></span>
				<h2 id="education-heading">{m.education_title()}</h2>
			</header>
			<ol>
				{
					education.map((item) => (
						<li>
							<time>{item.date}</time>
							<span>{item.body}</span>
							{item.note && <small>{item.note}</small>}
						</li>
					))
				}
			</ol>
		</section>

		<section id="credentials" class="record-panel mt-4" aria-labelledby="credentials-heading">
			<header>
				<span class="row-icon"><ShieldCheck /></span>
				<h2 id="credentials-heading">{m.nav_credentials()}</h2>
			</header>
			<ol>
				{
					credentials.map((item) => (
						<li>
							<time>{item.date}</time>
							<span>{item.body}</span>
						</li>
					))
				}
			</ol>
		</section>
	</section>
</BaseLayout>

<style>
	.card-page {
		width: min(100% - 2rem, 38rem);
		margin-inline: auto;
		padding-block: 1.25rem 4rem;
	}
	.app-panel,
	.record-panel {
		border: 1px solid var(--border);
		border-radius: 1rem;
		background: var(--card);
		box-shadow: 0 0.8rem 2.5rem -2rem rgb(38 52 82 / 0.32);
	}
	.app-panel {
		padding: 1.25rem;
	}
	.app-panel > h2 {
		margin-bottom: 0.8rem;
		font-size: 0.72rem;
		font-weight: 750;
		letter-spacing: 0.1em;
		color: var(--muted-foreground);
		text-transform: uppercase;
	}
	.note-social strong {
		overflow: hidden;
		font-size: 0.85rem;
		font-weight: 650;
		text-overflow: ellipsis;
	}
	.row-icon {
		display: grid;
		width: 2.5rem;
		height: 2.5rem;
		place-items: center;
		border-radius: 0.75rem;
		background: color-mix(in srgb, var(--primary) 13%, white);
		color: color-mix(in srgb, var(--primary) 72%, #11203e);
	}
	.row-icon :global(svg),
	.row-icon img {
		width: 1rem;
		height: 1rem;
	}
	.social-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.5rem;
	}
	.social-grid a {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		border: 1px solid var(--border);
		border-radius: 0.75rem;
		padding: 0.75rem;
		font-size: 0.78rem;
		font-weight: 650;
		transition: background-color 150ms ease;
	}
	.social-grid .note-social {
		display: grid;
		grid-column: 1 / -1;
		grid-template-columns: auto minmax(0, 1fr) auto;
		padding-block: 0.7rem;
	}
	.note-social > span {
		display: grid;
		min-width: 0;
		gap: 0.12rem;
	}
	.note-social small {
		font-size: 0.62rem;
		font-weight: 650;
		color: var(--muted-foreground);
	}
	.note-social :global(svg) {
		width: 0.95rem;
		height: 0.95rem;
		color: var(--muted-foreground);
	}
	.social-grid a:hover {
		background: var(--muted);
	}
	.social-grid img {
		width: 0.95rem;
		height: 0.95rem;
		object-fit: contain;
	}
	.record-panel {
		overflow: hidden;
	}
	.record-panel header {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		padding: 1rem 1.25rem;
	}
	.record-panel header h2 {
		font-size: 0.9rem;
		font-weight: 700;
	}
	.record-panel ol {
		display: grid;
		border-top: 1px solid var(--border);
		padding: 0.45rem 1.25rem 0.9rem 4.55rem;
	}
	.record-panel li {
		display: grid;
		gap: 0.2rem;
		border-bottom: 1px solid var(--border);
		padding-block: 0.8rem;
	}
	.record-panel li:last-child {
		border-bottom: 0;
	}
	.record-panel time {
		font-size: 0.66rem;
		font-weight: 700;
		color: color-mix(in srgb, var(--primary) 70%, #11203e);
	}
	.record-panel li span {
		font-size: 0.82rem;
		line-height: 1.55;
	}
	.record-panel li small {
		font-size: 0.7rem;
		font-weight: 650;
		color: var(--muted-foreground);
	}
	@media (min-width: 640px) {
		.card-page {
			padding-top: 2.25rem;
		}
		.app-panel {
			padding: 1.4rem;
		}
		.social-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
</style>
