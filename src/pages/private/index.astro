---
import { KeyRound, LockKeyhole } from '@lucide/astro';

import ProfileContent from '@/components/ProfileContent.astro';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { PRIVATE_SESSION_COOKIE, verifyPrivateSession } from '@/lib/server/auth';
import { privateAuthConfiguration, privateContacts } from '@/lib/server/contacts';
import * as m from '@/paraglide/messages';
import { getLocale, type Locale } from '@/paraglide/runtime';

const locale: Locale = getLocale();
const auth = privateAuthConfiguration();
const configured = Boolean(auth.password && auth.sessionSecret);
const cookie = Astro.cookies.get(PRIVATE_SESSION_COOKIE)?.value;
const authenticated = configured && verifyPrivateSession(cookie, auth.sessionSecret ?? '');
const error = Astro.url.searchParams.get('error');
const details = authenticated ? privateContacts() : undefined;
---

<BaseLayout {locale} mode="private" isAuthenticated={authenticated}>
	{
		authenticated && details ? (
			<ProfileContent {locale} {details} privateMode />
		) : (
			<section class="login-page">
				<div class="login-card">
					<div class="mx-auto grid size-14 place-items-center rounded-full bg-primary text-primary-foreground">
						<LockKeyhole class="size-6" />
					</div>
					<h1>{m.private_login_title()}</h1>

					{!configured && (
						<p role="alert" class="alert warning">
							{m.private_unavailable()}
						</p>
					)}
					{error === 'invalid' && (
						<p role="alert" class="alert error">
							{m.private_invalid()}
						</p>
					)}
					{error === 'expired' && (
						<p role="alert" class="alert warning">
							{m.private_session_expired()}
						</p>
					)}

					<form method="post" action={`/${locale}/private/session`} class="mt-6 grid gap-3">
						<label for="access-password" class="sr-only">
							{m.private_password_label()}
						</label>
						<Input
							id="access-password"
							name="password"
							type="password"
							autocomplete="current-password"
							placeholder={m.private_password_placeholder()}
							required
							maxlength={256}
							disabled={!configured}
							class="h-12 rounded-full px-5"
						/>
						<Button type="submit" variant="brand" size="lg" class="w-full" disabled={!configured}>
							<KeyRound />
							{m.private_unlock()}
						</Button>
					</form>
				</div>
			</section>
		)
	}
</BaseLayout>

<style>
	.login-page {
		display: grid;
		min-height: calc(100svh - 8rem);
		place-items: center;
		padding: 1.5rem;
	}
	.login-card {
		width: min(100%, 24rem);
		border: 1px solid var(--border);
		border-radius: 1.5rem;
		background: var(--card);
		padding: 2rem;
		text-align: center;
		box-shadow: 0 0.8rem 2.5rem -2rem rgb(38 52 82 / 0.32);
	}
	.login-card h1 {
		margin-top: 1rem;
		font-size: 1.5rem;
		font-weight: 720;
	}
	.alert {
		margin-top: 1rem;
		border-radius: 0.9rem;
		padding: 0.75rem;
		font-size: 0.75rem;
	}
	.alert.warning {
		background: #fff5d9;
		color: #674a0e;
	}
	.alert.error {
		background: #fff0f0;
		color: #8c2424;
	}
</style>
